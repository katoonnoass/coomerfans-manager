# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coomerfans?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Storage
STORAGE_PATH="./storage"
MEDIA_PATH="./media"

# Scraper
SCRAPER_DELAY_MS=2000
SCRAPER_MAX_CONCURRENT=3
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# IDM integration
# Optional explicit IDM executable path.
IDM_PATH="C:\\Program Files (x86)\\Internet Download Manager\\IDMan.exe"
# Public backend URL used inside generated IDM queue files.
IDM_IMPORT_BASE_URL="http://127.0.0.1:3001"

# Frontend
VITE_API_BASE_URL="/api"
